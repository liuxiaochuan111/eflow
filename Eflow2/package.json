    "vite": "^5.2.0",
    "vue-tsc": "^2.0.7",
    "@types/node": "^20.12.7",
    "@types/sortablejs": "^1.15.7",
    "vitest": "^1.5.0",
    "@vue/test-utils": "^2.4.5",
