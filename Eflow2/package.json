{
  "name": "eflow2-form-builder",
  "version": "1.0.0",
  "description": "Enterprise Form Builder with Visual Drag & Drop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
